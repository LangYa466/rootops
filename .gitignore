# Gradle / Android build outputs
build/
**/build/
.gradle/
.kotlin/

# Local machine config (SDK path, IDE state)
local.properties
.idea/
*.iml

# QA artifacts (screenshots are regenerated by scripts/qa-tour.py; report.md is tracked)
qa/*.png
qa/.ui.xml

# README assets are tracked (negations keep this explicit if ignore rules move)
!docs/screenshots/
!docs/screenshots/*.webp

# Logs and OS junk
*.log
.DS_Store
